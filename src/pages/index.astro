---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import Hero from "@/components/widgets/Hero.astro";
import Features from "@/components/widgets/Features.astro";
import devImg from "@/assets/images/dev_balanced.png";
import openSourceImg from "@/assets/images/open-source.png";
import Content from "@/components/widgets/Content.astro";
import Content2 from "@/components/widgets/Content2.astro";
import ProductList from "@/components/widgets/ProductList.astro";

const metadata = {
  title: `${siteConfig.name} — Central Texas Digital Marketers`,
  description:
    "A modern and professional template for your web projects with Astro and Tailwind CSS. Boost your development with a solid foundation.",
  ignoreTitleTemplate: true,
};

const products = [
  {
    title: "Starter Setup",
    description:
      "Get setup for the basics, we will get you on the digital map and start getting Texans to see you.",
    price: "500",
    monthly: false,
    setupFee: true,
    addon: false,
    features: [
      "Google Business Listing",
      "Google Analytics",
      "Custom Solution Planning",
    ],
    icon: "lucide:globe",
  },
  {
    title: "Retainer Services",
    description: "Set up digital advertising to draw customers in.",
    price: "$2500",
    monthly: true,
    addon: false,
    features: [
      "Google Ads Campaigns",
      "Customer Relationship Management",
      "Find out where your leads find you",
      "You control the process",
      "* Your budget adds to the cost",
    ],
    icon: "lucide:search-alert",
  },
  {
    title: "Automate Outreach",
    description:
      "Leverage all the available technology to make your customers lives easier and their experience outstanding.",
    price: "$5000",
    monthly: true,
    addon: false,
    features: [
      "Advanced campaigns to drive engagement",
      "Referral Plans",
      "Automated Solutions Planning",
      "",
    ],
    icon: "lucide:brain-cog",
  },
  {
    title: "Website Changes",
    description: "We will tackle the changes you need made to your website.",
    price: "$500",
    setupFee: false,
    monthly: false,
    addon: true,
    features: [
      "Optimize Page Speed",
      "Make Content Changes",
      "Manage Google scripts",
      "",
    ],
    icon: "lucide:brain-cog",
  },
];
---

<BaseLayout {metadata}>
  <Hero
    title={`Central Texas based <br class="hidden md:block" /> <span class="bg-linear-to-r from-rose-700 via-blue-400 to-blue-900 bg-clip-text text-transparent">Web Marketing</span>`}
    tagline={`${siteConfig.description}`}
    description={`<p>We take pride in supporting central Texas businesses that make us proud.</p><p>We support those who give back to their community.</p><p> We help Texans get exposure and help them establish themselves in the digital world.</p>`}
    actions={[
      {
        text: "Get Started",
        href: "https://github.com/devgelo-labs/astro-starter-pro",
        variant: "primary",
        icon: "lucide:github",
      },
      {
        text: "Our Services",
        href: "/services",
        variant: "secondary",
        icon: "lucide:arrow-right",
        ariaLabel: "Learn more about our services",
      },
    ]}
  />

  <Content
    tagline="Services"
    title="Our Services"
    description={[
      "Comprehensive solutions designed to maximize the potential of your digital presence.",
    ]}
  />
  <ProductList
    products={products.filter((x) => !x.addon)}
    classes={{ container: "pt-0 md:pt-0" }}
  />
  <Content
    tagline="Addon Services"
    title="Our Additional Services"
    description={["Comprehensive solutions for web development."]}
  />
  <ProductList
    products={products.filter((x) => x.addon)}
    classes={{ container: "pt-0 md:pt-0" }}
  />

  <Features
    tagline="Features"
    title="What's Included"
    subtitle="A selection of tools and configurations to streamline your workflow."
    features={[
      {
        title: "Efficient Ad Campaigns",
        description:
          "Creating custom ad campaigns to find the people you are looking for is our goal. Get your customers to find you when they need you. ",
        icon: "lucide:monitor-check",
        iconClass: "bg-emerald-500/10 text-emerald-400",
      },
      {
        title: "Leveraging Technology",
        description:
          "We aim to take the manual processes to the next level by automating the flow and streamlining the process.",
        icon: "lucide:atom",
        iconClass: "bg-red-500/10 text-red-400",
      },
      {
        title: "We will cater to you",
        description:
          "Every client is different, they all have different goals, we will cater to your needs and work with you the whole way through.",
        icon: "lucide:chef-hat",
        iconClass: "bg-blue-500/10 text-blue-400",
      },
    ]}
  />
  <Content2
    items={[
      {
        title: "Responsive Design",
        description:
          "Base configuration for Meta tags, Open Graph, and Sitemap generation.",
        icon: "lucide:scan-search",
        iconClass: "bg-blue-500/10 text-blue-400",
      },
      {
        title: "High Performance",
        description: "Lightweight structure for fast load times.",
        icon: "lucide:zap",
        iconClass: "bg-purple-500/10 text-purple-400",
      },
      {
        title: "Tailwind v4",
        description:
          "Integrated configuration with the latest version of Tailwind CSS.",
        icon: "lucide:palette",
        iconClass: "bg-pink-500/10 text-pink-400",
      },
    ]}
    image={devImg}
    imageAlt="Development"
  >
    <Fragment>
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">
        Development
      </h3>
      We provide a solid foundation to start your projects with best practices.
    </Fragment>
  </Content2>
  <Content2
    items={[
      {
        title: "Texan and Veteran Owned",
        description:
          "We give Veterans discounts and prioritize clients that show they are doing good for their communities and show Texan pride.",
        icon: "lucide:landmark",
        iconClass: "bg-indigo-500/10 text-indigo-400",
      },
      {
        title: "Community Driven",
        description:
          "We are focused on helping Texans get more exposure to local communities.",
        icon: "lucide:users",
        iconClass: "bg-orange-500/10 text-orange-400",
      },
      {
        title: "Client Focused",
        description:
          "We leverage technology to make your and our lives easier, so that you don't have to worry about all the technical details. We are here to make you standout, not us.",
        icon: "lucide:refresh-cw",
        iconClass: "bg-teal-500/10 text-teal-400",
      },
    ]}
    image={openSourceImg}
    imageAlt="Community Driven"
    isReversed={true}
  >
    <Fragment>
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">
        Reach out to Texans
      </h3>
      We are born and raised in Texas and want to help Texas companies reach out more
      across the great state. Focused on local based exposure and giving back to our
      community.
    </Fragment>
  </Content2>
</BaseLayout>
